       "line": 51
      }
     ]
    },
    {
     "role": "code",
     "ph": 103,
     "items": [
      {
       "text": "import pandas as pd",
       "line": 54
      },
      {
       "text": "",
       "line": 55
      },
      {
       "text": "base = \"https://raw.githubusercontent.com/ageron/data/main\"",
       "line": 56
      },
      {
       "text": "df = pd.read_csv(f\"{base}/housing/housing.csv\")",
       "line": 57
      },
      {
       "text": "",
       "line": 58
      },
      {
       "text": "print(df.shape)                          # (결과) (20640, 10)",
       "line": 59
      },
      {
       "text": "print(df[\"median_house_value\"].mean())   # (결과) 206855.82",
       "line": 60
      },
      {
       "text": "print(df.isna().sum().sum())             # (결과) 207",
       "line": 61
      }
     ]
    },
    {
     "role": "notes",
     "items": [
      {
       "text": "두 도구에 같은 요청을 넣고 결과가 같은지 본다. 값이 다르면 그 자리에서 원인을 찾는다.",
       "line": 63
      }
     ]
    }
